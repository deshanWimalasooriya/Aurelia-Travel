# Copy to ".env" and fill in. Never commit the real .env.

PORT=5000
JWT_SECRET=change-me

# ---- Database (MySQL / TiDB) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=aurelia_travel

# ---- Built-in Smart Plan (fallback when the agent is offline) ----
GEMINI_API_KEY=
OPENAI_API_KEY=

# ---- travel-Agent-2.0 (Python CrewAI service) ----
# Where the agent's FastAPI server runs (uvicorn app.api.main:app --port 8000)
AGENT_URL=http://localhost:8000
# Shared secret. Put the SAME value in the agent's .env as AGENT_API_KEY and AURELIA_API_KEY.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_API_KEY=
# Currency that rooms.base_price_per_night is stored in (USD or LKR). Tells the agent
# how to compare hotel prices against the traveller's budget.
HOTEL_PRICE_CURRENCY=USD
